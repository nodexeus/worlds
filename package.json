{
  "name": "nodexeus-worlds",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "A Nodexeus campus for your agents, workflows, and shared knowledge.",
  "license": "MIT",
  "author": "Jarren Rocks",
  "homepage": "https://www.nodexeus.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodexeus/worlds.git"
  },
  "bugs": {
    "url": "https://github.com/nodexeus/worlds/issues"
  },
  "keywords": [
    "claude-code",
    "coding-agent",
    "three.js",
    "webgl",
    "colony-sim",
    "developer-tools",
    "visualization"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "dev": "npm run assets --silent && vite",
    "build": "npm run assets --silent && vite build",
    "start": "vite build && node server/serve.mjs",
    "serve": "node server/serve.mjs",
    "assets": "node tools/build-assets.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "desktop:dev": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --mac dir --arm64",
    "desktop:dist": "npm run build && electron-builder --mac dmg --arm64",
    "desktop:icons": "swift tools/build-desktop-icons.swift && iconutil -c icns desktop/assets/BotCrossing.iconset -o desktop/assets/icon.icns",
    "test:desktop": "node --test test/desktop-*.test.mjs test/http-server.test.mjs",
    "test:electron": "electron test/electron-smoke.mjs"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "vite": "^7.1.0"
  }
}
